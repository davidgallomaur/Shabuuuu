"use client";

import {
  MapContainer,
  TileLayer,
  Polyline,
  Marker,
  Popup,
} from "react-leaflet";
import "leaflet/dist/leaflet.css";

export default function MapView({ selected }: any) {
  const center: [number, number] = [19.076, 72.8777];

  return (
    <MapContainer center={center} zoom={11} className="h-full w-full">
      <TileLayer
        url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
      />

      {selected && (
        <>
          <Polyline positions={selected.coords} />
          {selected.coords.map((c: any, i: number) => (
            <Marker key={i} position={c}>
              <Popup>Stop {i + 1}</Popup>
            </Marker>
          ))}
        </>
      )}
    </MapContainer>
  );
}
